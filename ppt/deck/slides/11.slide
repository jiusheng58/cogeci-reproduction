<Slide style={{ width: 1280, height: 720, backgroundColor: '#FFFFFF', padding: '56px 72px' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14 }}>
        <Box style={{ width: 5, height: 34, backgroundColor: '#1C3F78' }} />
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1C3F78' }}>结论与不足</Text>
        <Text style={{ fontSize: 16, color: '#A7B0BE', marginLeft: 8 }}>06 / 哪些能说，哪些不能说</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 34, marginTop: 26 }}>
        <Box style={{ width: 552, flexDirection: 'column', gap: 11 }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1C3F78' }}>四条站得住的结论</Text>
            {[
                ['链路通了', '补齐四类缺失文件后完整跑通 5 折；存在性 F1 = 0.6493，高于 iLIF 报告的 62.5'],
                ['替代方案可用', '规则法伪标签与 LLM 标注句级精确率 0.985，97.4% 的样本被 LLM 答案完全包含'],
                ['优化可信', '5 处改写取得 12–17 倍加速，loss 偏差为 0、梯度偏差 < 10⁻⁸，并非改快了但改错了'],
                ['找到一处方法级缺陷', 'CGL 的二值化切断计算图，w = 0 / 3 / 6 训练轨迹逐位相同；伪标签链路原本是空转的'],
            ].map((r, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 12 }}>
                    <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#C8892A', width: 20 }}>0{i + 1}</Text>
                    <Box style={{ flexDirection: 'column', gap: 3, width: 512 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1C3F78' }}>{r[0]}</Text>
                        <Text style={{ fontSize: 13, color: '#5B6673', lineHeight: 1.55 }}>{r[1]}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        <Box style={{ width: 550, backgroundColor: '#F4F6F9', padding: '18px 22px', flexDirection: 'column', gap: 9 }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#1C3F78' }}>必须写明的四处偏差</Text>
            {[
                ['伪标签尚未真正生效', '规则法只做到“造得对”，还差“用得上”：需先修复 CGL 的梯度'],
                ['原文未能取得全文', '方法依据代码重建，数字为推断而非原文声明'],
                ['单种子、单一划分', '5 折间标准差不是种子间方差'],
                ['未做方向口径实验', '三分类配置已随仓库提供，尚欠一组对照'],
            ].map((r, i) => (
                <Box key={i} style={{ flexDirection: 'row', gap: 10 }}>
                    <Text style={{ fontSize: 13, color: '#A7B0BE' }}>·</Text>
                    <Box style={{ flexDirection: 'column', width: 476 }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#33404F' }}>{r[0]}</Text>
                        <Text style={{ fontSize: 12, color: '#8A94A6', lineHeight: 1.5 }}>{r[1]}</Text>
                    </Box>
                </Box>
            ))}
        </Box>
    </Box>

    <Box style={{ marginTop: 24, borderTop: '1px solid #E2E8F0', paddingTop: 14, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1C3F78' }}>交付物</Text>
            <Text style={{ fontSize: 13, color: '#8A94A6' }}>LaTeX 源文件包 · 报告 PDF · 汇报 PPT · 5 折权重</Text>
        </Box>
        <Box style={{ flexDirection: 'column', alignItems: 'flex-end', gap: 4 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1C3F78' }}>源代码</Text>
            <Text style={{ fontSize: 13, color: '#2E6CB5' }}>github.com/jiusheng58/cogeci-reproduction</Text>
        </Box>
    </Box>
</Slide>
